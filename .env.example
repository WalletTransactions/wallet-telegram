# wallet-telegram — пример .env. Скопируйте в .env и заполните. .env в git не
# попадает (.gitignore), в нём секреты.

# Токен бота от @BotFather. Даёт полный контроль над ботом — не коммитить, не
# вставлять в чаты и тикеты.
TELEGRAM_BOT_TOKEN=

# Username бота без '@' — чтобы команды вида /start@WalletTransaction_bot
# распознавались как свои.
TELEGRAM_BOT_USERNAME=WalletTransaction_bot

# Общий секрет с google-auth: ТОТ ЖЕ, что TELEGRAM_SERVICE_SECRET в
# google-auth/.env (заголовок X-Service-Secret у /internal/telegram/*).
# Им бот получает токены пользователей — хранить как пароль.
# Сгенерировать: openssl rand -hex 32
TELEGRAM_SERVICE_SECRET=

# TELEGRAM_TOKEN_ENC_KEY больше не нужен (с 2026-09-30 бот не хранит токенов,
# org/docs/TODO_telegram_tokens.md) — строку можно удалить из .env.

# Закрытое тестирование: бот отвечает только этим Telegram user id (через
# запятую). Пусто — открыт всем.
TELEGRAM_ALLOWED_USER_IDS=

# Часовой пояс новых связок (IANA) — пользователь поменяет командой /tz.
TELEGRAM_DEFAULT_TZ=Europe/Moscow

# Сколько секунд Telegram держит getUpdates, если апдейтов нет.
# TELEGRAM_POLL_TIMEOUT_SECS=25

# Для запуска вне контейнера. В compose все четыре переопределены (compose.yaml).
AUTH_SERVICE_URL=http://127.0.0.1:8080
WALLET_REPORT_URL=http://127.0.0.1:8084
WALLET_API_URL=http://127.0.0.1:8082
DATABASE_URL=postgresql://wallet_telegram:change-me-telegram@localhost:15432/wallet_telegram

# HOST=127.0.0.1
# PORT=8086
# LOG_DIR=
# LOG_SQL_PARAMS=false
